kml-5280\",\"kml-5281\",\"kml-5282\",\"kml-5283\",\"kml-5284\",\"kml-5285\",\"kml-5286\",\"kml-5287\",\"kml-5288\",\"kml-5289\",\"kml-5290\",\"kml-5291\",\"kml-5292\",\"kml-5293\",\"kml-5294\",\"kml-5295\",\"kml-5296\",\"kml-5297\",\"kml-5298\",\"kml-5299\",\"kml-5300\",\"kml-5301\",\"kml-5302\",\"kml-5303\",\"kml-5304\",\"kml-5305\",\"kml-5306\",\"kml-5307\",\"kml-5308\",\"kml-5309\",\"kml-5310\",\"kml-5311\",\"kml-5312\",\"kml-5313\",\"kml-5314\",\"kml-5315\",\"kml-5316\",\"kml-5317\",\"kml-5318\",\"kml-5319\",\"kml-5320\",\"kml-5321\",\"kml-5322\",\"kml-5323\",\"kml-5324\",\"kml-5325\",\"kml-5326\",\"kml-5327\",\"kml-5328\",\"kml-5329\",\"kml-5330\",\"kml-5331\",\"kml-5332\",\"kml-5333\",\"kml-5334\",\"kml-5335\",\"kml-5336\",\"kml-5337\",\"kml-5338\",\"kml-5339\",\"kml-5340\"],\"kmlLayerMenu\":\"$undefined\",\"kmlMenuFolders\":\"$undefined\"},\"legend\":[]},{\"id\":\"UyjJ0Bstydkpzz6j550QQDTa\",\"order\":12,\"title\":\"آسیب‌پذیری شبکه ریلی در مرکز \",\"content\":[{\"id\":\"03bddc023f97\",\"type\":\"text\",\"html\":\"\u003cp\u003eراه‌آهن بادرود تا قم، جایگاه راهبردی دارد. این مسیر شیراز، اصفهان، کرمان و یزد در مرکز، بندرعباس در جنوب و زاهدان را در جنوب شرق به تهران متصل می‌کند. حمله به پل یحیی‌آباد در حاشیه شهر کاشان، مشابه پل یحیی‌آباد، دو تقاطع غیرهم‌سطح دیگر وجود دارد. به جز یک پل در محدوده مهرآباد و یک پل در محدوده بادرود، سایر پل‌ها در واقع کالورت‌های کوچک هستند.\u003c/p\u003e\",\"treeNodeId\":\"$undefined\",\"imageRegionId\":\"$undefined\",\"graphNodeIds\":\"$undefined\"},{\"id\":\"cb593b8cbdeb\",\"type\":\"image\",\"src\":\"https://cdn.sanity.io/images/rdk9umy0/production/57157d907edd798406e561f549128221dcb21407-4000x2250.png?w=1600\u0026fit=max\u0026auto=format\",\"caption\":\"\",\"alt\":\"\",\"popup\":true,\"credit\":\"$undefined\"},{\"id\":\"4e2b9b1a4bc3\",\"type\":\"text\",\"html\":\"\u003cp\u003eاز بادرود تا اصفهان و در مسیرهای منشعب در جنوب اصفهان به سمت مبارکه، بهارستان و ذوب‌آهن ۶۰ پل با دهانه بزرگ‌تر از ۳۰ متر و ۲ تونل وجود دارد. تنها دو پل با دهانه بزرگ‌تر از ۱۰۰ متر در این مسیر وجود دارد. بر این اساس این مسیر نسبتا مطمئنی به‌شمار می‌رود.\u003c/p\u003e\u003cp\u003eاما از اصفهان تا شیراز، ۲۳ پل و ۲۱ تونل واقع شده است. در این مسیر ۶ پل بزرگ وجود دارد. از آن جمله می‌توان به پل ایزدخواست و پل مرودشت اشاره کرد.\u003c/p\u003e\u003cp\u003eاز اردکان، دو مسیر به سمت غرب وجود دارد. یکی مسیر شمالی که از بادرود به تهران می‌رسد و مسیر جنوبی که به اصفهان می‌رود. در مسیر شمالی ۱۱ پل و در مسیر جنوبی ۸ پل وجود دارد. ده‌ها کالورت کوچک نیز در این مسیرها هستند. همگی روی رودخانه‌های فصلی و تقاطع‌ها بنا شدند. هیچ پل راهبردی و بزرگی در این منطقه وجود ندارد.\u003c/p\u003e\",\"treeNodeId\":\"$undefined\",\"imageRegionId\":\"$undefined\",\"graphNodeIds\":\"$undefined\"}],\"date\":\"\",\"showInIndex\":true,\"visualBackground\":\"$undefined\",\"contentLayout\":\"$undefined\",\"contentBackground\":\"$undefined\",\"contentForeground\":\"$undefined\",\"contentHeading\":\"$undefined\",\"contentFeather\":\"$undefined\",\"thumbnail\":\"https://cdn.sanity.io/images/rdk9umy0/production/0b98232963c80bb2ff6d946a8c404b1ff05971f6-2099x1175.png?w=256\u0026fit=max\u0026auto=format\",\"mainView\":\"map\",\"map\":{\"center\":[52.75027266910456,32.58370110773204],\"zoom\":6.271,\"bearing\":0,\"pitch\":0,\"style\":\"$undefined\",\"layers\":[],\"inset\":\"$undefined\",\"slides\":[],\"slidesLoop\":\"$undefined\",\"kmlFeatureIds\":\"$undefined\",\"kmlLayerIds\":[\"کل-شبکه-راه-آهن-سراسری\",\"نقاط-حساس-ریلی-مرکز-و-جنوب-غرب\",\"ریلی-اصفهان-اردکان\",\"ریلی-سیستان-۱\",\"ریلی-اصفهان-شیراز\",\"ریلی-تهران-قم\"],\"kmlExcludeIds\":[\"kml-2949\",\"kml-2950\",\"kml-2951\",\"kml-2952\",\"kml-2953\",\"kml-2954\",\"kml-2955\",\"kml-2958\",\"kml-2959\",\"kml-2960\",\"kml-2963\"],\"kmlLabelIds\":[\"kml-2942\",\"kml-2943\",\"kml-2944\",\"kml-2945\",\"kml-2946\",\"kml-2947\",\"kml-2948\",\"kml-2957\",\"kml-2961\",\"kml-2962\",\"kml-2964\",\"kml-2965\"],\"kmlTooltipOffIds\":[\"kml-4762\",\"kml-4763\",\"kml-4764\",\"kml-4765\",\"kml-4766\",\"kml-4767\",\"kml-4768\",\"kml-4769\