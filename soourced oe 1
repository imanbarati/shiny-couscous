-4557\",\"kml-4558\",\"kml-4559\",\"kml-4560\",\"kml-4561\",\"kml-4562\",\"kml-4563\",\"kml-4688\",\"kml-4689\",\"kml-4690\",\"kml-4691\",\"kml-4692\",\"kml-4693\",\"kml-4694\",\"kml-4695\",\"kml-4696\",\"kml-4697\",\"kml-4698\",\"kml-4699\",\"kml-4700\",\"kml-4701\",\"kml-4702\",\"kml-4703\",\"kml-4704\",\"kml-4705\",\"kml-4706\",\"kml-4707\",\"kml-4708\",\"kml-4709\",\"kml-4710\",\"kml-4711\",\"kml-4712\",\"kml-4713\",\"kml-4714\",\"kml-4715\",\"kml-4716\",\"kml-4717\",\"kml-4718\",\"kml-4719\",\"kml-4720\",\"kml-4721\",\"kml-4722\",\"kml-4723\",\"kml-4724\",\"kml-4725\",\"kml-4726\",\"kml-4727\",\"kml-4728\",\"kml-4729\",\"kml-4730\",\"kml-4731\",\"kml-4732\",\"kml-4733\",\"kml-4734\",\"kml-4735\",\"kml-4736\",\"kml-4737\",\"kml-4738\",\"kml-4739\",\"kml-4740\",\"kml-4741\",\"kml-4742\",\"kml-4743\",\"kml-4744\",\"kml-4745\",\"kml-4746\",\"kml-4747\",\"kml-4748\",\"kml-4749\",\"kml-4750\",\"kml-4751\",\"kml-4752\",\"kml-4753\",\"kml-4754\",\"kml-4755\",\"kml-4756\",\"kml-4757\",\"kml-4758\",\"kml-4759\",\"kml-4760\",\"kml-4761\"],\"kmlLayerMenu\":\"$undefined\",\"kmlMenuFolders\":\"$undefined\"},\"legend\":[]},{\"id\":\"1oAabKipcZ5uGoJPwnrz7NEi\",\"order\":10,\"title\":\"آسیب‌پذیری شبکه ریلی در مرکز و جنوب غرب\",\"content\":[{\"id\":\"d458f8b860b9\",\"type\":\"text\",\"html\":\"\u003cp\u003eراه‌آهن سراسری از طریق دو خط به سمت غرب از پرندک در جنوب غربی تهران، به همدان و سپس به نزدیکی سنندج می‌رسد. راه‌آهن دوم، از قم، با عبور از اراک، شازند، ملایر و بیستون به نزدیکی کرمانشاه متصل شده است.\u003c/p\u003e\u003cp\u003eراه‌آهن جنوب شرق از مرزش شلمچه در منتهای جنوب غربی کشور و خرمشهر آغاز می‌شود، در اهواز به راه‌آهن بندر شاهپور (امام) و بندر ماهشهر می‌رسد. از اهواز، با گذر از شوش و دزفول در شازند، به راه‌آهن قم-کرمانشاه می‌رسد و از آنجا به تهران وصل می‌شود.\u003c/p\u003e\u003cp\u003eراه‌آهن دیگر، از قم به سمت جنوب شرقی حرکت می‌کند؛ از کاشان می‌گذرد و در دو راهی ایستگاه بادرود، از یک سو به سمت اردکان و از سوی دیگر به سمت اصفهان حرکت می‌کند. در اصفهان این راه‌آهن، دوباره در یک دو راهی، یکی به سمت اردکان و دیگری به سمت شیراز حرکت می‌کند.\u003c/p\u003e\u003cp\u003eحمله به پل هفت‌دهانه قم، ارتباط کرمانشاه، اراک، شازند، اهواز، بندر ماهشهر، بندر شاهپور (امام) و بندر خرمشهر را قطع کرد و پل یحیی‌آباد، ارتباط راه‌آهن اصفهان، اردکان، شیراز را قطع کرد. البته این پل در راه‌آهن جنوب و مرکز و جنوب شرقی هم موثر است.\u003c/p\u003e\",\"treeNodeId\":\"$undefined\",\"imageRegionId\":\"$undefined\",\"graphNodeIds\":\"$undefined\"}],\"date\":\"\",\"showInIndex\":true,\"visualBackground\":\"$undefined\",\"contentLayout\":\"$undefined\",\"contentBackground\":\"$undefined\",\"contentForeground\":\"$undefined\",\"contentHeading\":\"$undefined\",\"contentFeather\":\"$undefined\",\"thumbnail\":\"https://cdn.sanity.io/images/rdk9umy0/production/31c3215ac1e7e79f256b159aad0fc512896c8d19-2103x1180.png?w=256\u0026fit=max\u0026auto=format\",\"mainView\":\"map\",\"map\":{\"center\":[50.677522861233,33.07560687024613],\"zoom\":5.95,\"bearing\":0,\"pitch\":0,\"style\":\"$undefined\",\"layers\":[],\"inset\":\"$undefined\",\"slides\":[],\"slidesLoop\":\"$undefined\",\"kmlFeatureIds\":[\"kml-3083\"],\"kmlLayerIds\":[\"کل-شبکه-راه-آهن-سراسری\",\"نقاط-حساس-ریلی-مرکز-و-جنوب-غرب\"],\"kmlExcludeIds\":\"$undefined\",\"kmlLabelIds\":[\"kml-2942\",\"kml-2943\",\"kml-2944\",\"kml-2945\",\"kml-2946\",\"kml-2947\",\"kml-2948\",\"kml-2950\",\"kml-2951\",\"kml-2952\",\"kml-2953\",\"kml-2954\",\"kml-2956\",\"kml-2957\",\"kml-2958\",\"kml-2959\",\"kml-2960\",\"kml-2961\",\"kml-2962\",\"kml-2964\",\"kml-2965\",\"kml-3083\"],\"kmlTooltipOffIds\":\"$undefined\",\"kmlLayerMenu\":\"$undefined\",\"kmlMenuFolders\":\"$undefined\"},\"legend\":[]},{\"id\":\"qaw3x5s2v6oK3eGcHcdxrwsz\",\"order\":11,\"title\":\"پل‌ها و تونل‌های راه‌آهن سراسری در مرکز و جنوب غرب\",\"content\":[{\"id\":\"be80e8a98f60\",\"type\":\"text\",\"html\":\"\u003cp\u003eاز بندر ماهشهر تا اهواز و خرمشهر تا اهواز و از اهواز تا قم، جمعا ۱۱۳ تونل و ۷۴ پل با طول دهانه بیش از ۳۰ متر وجود دارد.\u003c/p\u003e\u003cp\u003eاین پل‌ها و تونل‌ها در دو بخش مسیر شامل: بندر ماهشهر و خرمشهر تا هفت تپه و دزفول تا دورود، تراکم بیشتری داشتند. در این بخش‌ها مسیر صعب‌العبور است و در برخی بخش‌ها، پل‌ها و تونل‌های کم‌نظیری چه از نظر طول و ارتفاع نسبت به کل راه‌آهن سراسری احداث شدند. تنها مشابه محدوده زاگرس در این راه‌آهن، محدوده ورسک در راه‌آهن شمال است.\u003c/p\u003e\",\"treeNodeId\":\"$undefined\",\"imageRegionId\":\"$undefined\",\"graphNodeIds\":\"$undefined\"},{\"id\":\"524792ddd5f2\",\"type\":\"image\",\"src\":\"https://cdn.sanity.io/images/rdk9umy0/production/6d7302a35cc5a3c565f53833aa7991980b5a48a7-4000x2250.png?w=1600\u0026fit=max\u0026auto=format\",\"caption\":\"\",\"alt\":\"\",\"popup\":true,\"credit\":\"$undefined\"},{\"id\":\"1af691e5758e\",\"type\":\"text\",\"html\":\"\u003cp\u003eمشهورترین پل در این مسیر، پل سیاه اهواز است که به طول بیش از یک کیلومتر روی رودخانه کارون بنا شده است. در بخش‌هایی از مسیر جنوبی، راه‌آهن از تالاب هورالعظیم گذر می‌کند.\u003c/p\u003e\u003cp\u003eاز مجموع ۷۴ پل، ۲۴ پل طولی بیش از ۱۰۰ متر دارند. به‌جز پل سیاه اهواز، پل‌ها روی رودخانه‌های دز، سزار، بختیاری و رودخانه‌های فصلی و دره‌ها بنا شدند. برخی از آنها، اهمیت بیشتری دارند و در صورت آسیب، بازسازی آنها کار آسانی نیست.\u003c/p\u003e\",\"treeNodeId\":\"$undefined\",\"imageRegionId\":\"$undefined\",\"graphNodeIds\":\"$undefined\"}],\"date\":\"\",\"showInIndex\":true,\"visualBackground\":\"$undefined\",\"contentLayout\":\"$undefined\",\"contentBackground\":\"$undefined\",\"contentForeground\":\"$undefined\",\"contentHeading\":\"$undefined\",\"contentFeather\":\"$undefined\",\"thumbnail\":\"https://cdn.sanity.io/images/rdk9umy0/production/a21f4a5f735331882f45297456e81b80ecf180fb-2103x1175.png?w=256\u0026fit=max\u0026auto=format\",\"mainView\":\"map\",\"map\":{\"center\":[49.469156534295735,32.67588795369977],\"zoom\":6.05,\"bearing\":0,\"pitch\":0,\"style\":\"$undefined\",\"layers\":[],\"inset\":\"$undefined\",\"slides\":[],\"slidesLoop\":\"$undefined\",\"kmlFeatureIds\":[\"kml-2943\",\"kml-2949\",\"kml-2950\",\"kml-2960\",\"k